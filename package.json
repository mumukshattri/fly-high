{
  "name": "job-n-job",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Job N Job - Centralized Campus Recruitment Management System (React + Express + MongoDB)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "email:indexes": "node server/email/create-indexes.js",
    "admin:create": "node server/provision-admin.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "express": "^5.3.0",
    "mongoose": "^8.24.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  }
}
