# ---------------------------------------------------------------------------
# Job N Job - environment template
#
#   cp .env.example .env      (then edit .env)
#
# .env is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# REQUIRED. The server refuses to start without it - there is no fallback to
# SQLite, localStorage or in-memory data.
MONGODB_URI=mongodb://127.0.0.1:27017/jobnjob

# Optional. Defaults shown.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# ---------------------------------------------------------------------------
# External job discovery (Adzuna) - OPTIONAL
#
# Without these two values the student portal still works; the
# "Discover External Opportunities" section simply says it is not configured.
# Create a free key at https://developer.adzuna.com/signup
#
# Both are used ONLY by the Express server. They are never sent to a browser.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country edition: in = India (default). See server/external-jobs.js for the list.
ADZUNA_COUNTRY=in
# Hard timeout for one provider call, and how long a search is cached.
ADZUNA_TIMEOUT_MS=8000
ADZUNA_CACHE_TTL_MS=600000
# Advanced: only change this to point at a local stand-in while testing.
# ADZUNA_API_BASE=https://api.adzuna.com/v1/api

# Optional. Comma-separated extra browser origins allowed to call the API.
# In development the Vite server (localhost:5173) is already allowed.
# APP_ORIGIN=https://portal.yourcollege.edu

# ---------------------------------------------------------------------------
# Resume storage and job matching (optional)
#
# Uploaded resumes are written to this PRIVATE directory. It is never served by
# the static middleware and is git-ignored. Point it at a mounted volume in
# production, or re-implement server/resume-store.js for object storage.
# RESUME_STORAGE_DIR=./storage/resumes
# Maximum accepted resume size in bytes (default 5 MB).
# RESUME_MAX_BYTES=5242880
# Matching weights (0 < w <= 1) and score labels (0-100).
# MATCH_WEIGHTS={"skills":0.4,"education":0.2,"experience":0.15,"location":0.1,"role":0.1,"employment":0.05}
# MATCH_THRESHOLDS={"excellent":80,"strong":65,"moderate":50}
# How long a CSV-import activation link stays valid (default 7 days).
# INVITE_TTL_MS=604800000
